{
  "info": {
    "name": "Pine Drink - Forgot Password",
    "description": "API collection for forgot password flow with OTP verification and JWT reset token",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Step 1: Request Forgot Password OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/forgot-password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "forgot-password"]
        },
        "description": "Request forgot password OTP. System will send OTP to email if account exists. OTP expires in 5 minutes."
      },
      "response": []
    },
    {
      "name": "Step 2: Verify OTP and Get Reset Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.data && jsonData.data.resetToken) {",
              "        pm.collectionVariables.set(\"resetToken\", jsonData.data.resetToken);",
              "        console.log(\"Reset token saved:\", jsonData.data.resetToken);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/forgot-password/verify-otp",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "forgot-password", "verify-otp"]
        },
        "description": "Verify OTP and receive reset token. Reset token expires in 5 minutes. Max 5 attempts."
      },
      "response": []
    },
    {
      "name": "Step 3: Reset Password",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{resetToken}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"newPassword\": \"NewSecurePass123!\",\n  \"confirmPassword\": \"NewSecurePass123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/auth/reset-password",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "auth", "reset-password"]
        },
        "description": "Reset password using reset token. All refresh tokens will be revoked after password reset."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "resetToken",
      "value": "",
      "type": "string"
    }
  ]
}
