<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="daily-revenue"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">

    <parameter name="branchName" class="java.lang.String"/>
    <parameter name="branchAddress" class="java.lang.String"/>
    <parameter name="fromDate" class="java.lang.String"/>
    <parameter name="toDate" class="java.lang.String"/>
    <parameter name="generatedAt" class="java.lang.String"/>
    <parameter name="totalOrders" class="java.lang.String"/>
    <parameter name="grossRevenue" class="java.lang.String"/>
    <parameter name="totalDiscount" class="java.lang.String"/>
    <parameter name="netRevenue" class="java.lang.String"/>

    <field name="paymentMethod" class="java.lang.String"/>
    <field name="orderCount" class="java.lang.Long"/>
    <field name="grossAmount" class="java.lang.String"/>
    <field name="discountAmount" class="java.lang.String"/>
    <field name="netAmount" class="java.lang.String"/>

    <title>
        <band height="145">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[BAO CAO DOANH THU]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="35" width="555" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$P{branchName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="58" width="555" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$P{branchAddress}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="88" width="270" height="20"/>
                <textFieldExpression><![CDATA["Tu ngay: " + $P{fromDate}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="285" y="88" width="270" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Den ngay: " + $P{toDate}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="115" width="555" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Tao luc: " + $P{generatedAt}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <pageHeader>
        <band height="35">
            <staticText>
                <reportElement x="0" y="10" width="140" height="20"/>
                <text><![CDATA[Phuong thuc]]></text>
            </staticText>
            <staticText>
                <reportElement x="140" y="10" width="65" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[So don]]></text>
            </staticText>
            <staticText>
                <reportElement x="205" y="10" width="115" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Gross]]></text>
            </staticText>
            <staticText>
                <reportElement x="320" y="10" width="115" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Giam gia]]></text>
            </staticText>
            <staticText>
                <reportElement x="435" y="10" width="120" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Net]]></text>
            </staticText>
        </band>
    </pageHeader>

    <detail>
        <band height="22">
            <textField>
                <reportElement x="0" y="0" width="140" height="20"/>
                <textFieldExpression><![CDATA[$F{paymentMethod}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="140" y="0" width="65" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{orderCount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="205" y="0" width="115" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{grossAmount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="320" y="0" width="115" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{discountAmount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="435" y="0" width="120" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{netAmount}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="120">
            <textField>
                <reportElement x="335" y="10" width="220" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Tong don: " + $P{totalOrders}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="335" y="35" width="220" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Gross: " + $P{grossRevenue}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="335" y="60" width="220" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Giam gia: " + $P{totalDiscount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="335" y="88" width="220" height="25"/>
                <textElement textAlignment="Right">
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Doanh thu net: " + $P{netRevenue}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
