<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="product-catalog"
              pageWidth="842"
              pageHeight="595"
              orientation="Landscape"
              columnWidth="802"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">

    <parameter name="title" class="java.lang.String"/>
    <parameter name="generatedAt" class="java.lang.String"/>
    <parameter name="statusFilter" class="java.lang.String"/>
    <parameter name="categoryFilter" class="java.lang.String"/>
    <parameter name="totalProducts" class="java.lang.String"/>

    <field name="productCode" class="java.lang.String"/>
    <field name="productName" class="java.lang.String"/>
    <field name="categoryName" class="java.lang.String"/>
    <field name="basePrice" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>
    <field name="preparationMinutes" class="java.lang.String"/>
    <field name="featured" class="java.lang.String"/>
    <field name="bestSeller" class="java.lang.String"/>
    <field name="variants" class="java.lang.String"/>
    <field name="createdAt" class="java.lang.String"/>

    <title>
        <band height="90">
            <textField>
                <reportElement x="0" y="0" width="802" height="30"/>
                <textElement textAlignment="Center"><font size="18" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{title}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="38" width="260" height="18"/>
                <textFieldExpression><![CDATA["Trang thai: " + $P{statusFilter}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="270" y="38" width="260" height="18"/>
                <textFieldExpression><![CDATA["Danh muc: " + $P{categoryFilter}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="540" y="38" width="262" height="18"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Tong SP: " + $P{totalProducts}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="62" width="802" height="18"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Tao luc: " + $P{generatedAt}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <pageHeader>
        <band height="30">
            <staticText><reportElement x="0" y="5" width="75" height="20"/><text><![CDATA[Ma SP]]></text></staticText>
            <staticText><reportElement x="75" y="5" width="145" height="20"/><text><![CDATA[Ten san pham]]></text></staticText>
            <staticText><reportElement x="220" y="5" width="100" height="20"/><text><![CDATA[Danh muc]]></text></staticText>
            <staticText><reportElement x="320" y="5" width="85" height="20"/><textElement textAlignment="Right"/><text><![CDATA[Gia goc]]></text></staticText>
            <staticText><reportElement x="405" y="5" width="70" height="20"/><text><![CDATA[Status]]></text></staticText>
            <staticText><reportElement x="475" y="5" width="45" height="20"/><textElement textAlignment="Right"/><text><![CDATA[Phut]]></text></staticText>
            <staticText><reportElement x="520" y="5" width="45" height="20"/><textElement textAlignment="Center"/><text><![CDATA[Hot]]></text></staticText>
            <staticText><reportElement x="565" y="5" width="45" height="20"/><textElement textAlignment="Center"/><text><![CDATA[Best]]></text></staticText>
            <staticText><reportElement x="610" y="5" width="192" height="20"/><text><![CDATA[Variants]]></text></staticText>
        </band>
    </pageHeader>

    <detail>
        <band height="28">
            <textField><reportElement x="0" y="2" width="75" height="22"/><textFieldExpression><![CDATA[$F{productCode}]]></textFieldExpression></textField>
            <textField><reportElement x="75" y="2" width="145" height="22"/><textFieldExpression><![CDATA[$F{productName}]]></textFieldExpression></textField>
            <textField><reportElement x="220" y="2" width="100" height="22"/><textFieldExpression><![CDATA[$F{categoryName}]]></textFieldExpression></textField>
            <textField><reportElement x="320" y="2" width="85" height="22"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{basePrice}]]></textFieldExpression></textField>
            <textField><reportElement x="405" y="2" width="70" height="22"/><textFieldExpression><![CDATA[$F{status}]]></textFieldExpression></textField>
            <textField><reportElement x="475" y="2" width="45" height="22"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{preparationMinutes}]]></textFieldExpression></textField>
            <textField><reportElement x="520" y="2" width="45" height="22"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{featured}]]></textFieldExpression></textField>
            <textField><reportElement x="565" y="2" width="45" height="22"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA[$F{bestSeller}]]></textFieldExpression></textField>
            <textField isStretchWithOverflow="true"><reportElement x="610" y="2" width="192" height="22"/><textFieldExpression><![CDATA[$F{variants}]]></textFieldExpression></textField>
        </band>
    </detail>
</jasperReport>
